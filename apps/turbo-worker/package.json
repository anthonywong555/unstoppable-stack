{
  "name": "@boilerplate/turbo-worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nodemon src/worker.ts",
    "build": "tsc --build",
    "build.watch": "tsc --build --watch",
    "build:workflow": "ts-node scripts/build-workflow-bundle.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "start": "ts-node src/worker.ts",
    "start.watch": "nodemon src/worker.ts",
    "workflow": "ts-node src/client.ts",
    "clean": "rm -rf node_modules/ .turbo/ lib/ tsconfig.tsbuildinfo workflow-bundle.js"
  },
  "nodemonConfig": {
    "execMap": {
      "ts": "ts-node"
    },
    "ext": "ts,cjs,mjs,js",
    "watch": [
      "src",
      "node_modules/@boilerplate/activities/dist",
      "node_modules/@boilerplate/workflows/dist",
      "node_modules/@boilerplate/common/dist"
    ],
    "ignoreRoot": []
  },
  "dependencies": {
    "@boilerplate/activities": "workspace:*",
    "@boilerplate/common": "workspace:*",
    "@boilerplate/workflows": "workspace:*",
    "@temporalio/activity": "catalog:",
    "@temporalio/client": "catalog:",
    "@temporalio/envconfig": "catalog:",
    "@temporalio/worker": "catalog:",
    "@temporalio/workflow": "catalog:",
    "@temporalio/interceptors-opentelemetry": "catalog:",
    "@opentelemetry/core": "^1.30.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.57.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.2",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.57.2",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.57.2",
    "@opentelemetry/exporter-prometheus": "^0.57.2",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-metrics": "^1.30.0",
    "@opentelemetry/auto-instrumentations-node": "^0.55.0",
    "@opentelemetry/sdk-node": "^0.57.2",
    "@opentelemetry/sdk-trace-node": "^1.30.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "triple-beam": "^1.3.0",
    "winston": "^3.3.3"
  },
  "devDependencies": {
    "@boilerplate/eslint-config": "workspace:*",
    "@tsconfig/node22": "^22.0.0",
    "@types/node": "^22.9.1",
    "@types/triple-beam": "^1.3.2",
    "nodemon": "catalog:",
    "prettier": "catalog:",
    "ts-node": "catalog:",
    "typescript": "catalog:"
  }
}
