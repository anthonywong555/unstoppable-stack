{
  "name": "@boilerplate/workflows",
  "version": "0.0.0",
  "private": true,
  "files": ["dist"],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./worker-a": {
      "import": {
        "types": "./dist/workers/worker-a.d.ts",
        "default": "./dist/workers/worker-a.mjs"
      },
      "require": {
        "types": "./dist/workers/worker-a.d.cts",
        "default": "./dist/workers/worker-a.cjs"
      }
    }
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "clean": "rm -rf node_modules/ .turbo/ dist/"
  },
  "dependencies": {
    "@temporalio/workflow": "catalog:"
  },
  "devDependencies": {
    "@boilerplate/activities": "workspace:*",
    "@boilerplate/common": "workspace:*",
    "@boilerplate/typescript-config": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}