{
  "name": "@boilerplate/activities",
  "version": "0.0.0",
  "private": true,
  "files": ["dist"],
  "type": "module",
  "exports": {
    "./example": {
      "import": {
        "types": "./dist/example.d.ts",
        "default": "./dist/example.js"
      },
      "require": {
        "types": "./dist/example.d.cts",
        "default": "./dist/example.cjs"
      }
    }
  },
  "scripts": {
    "dev": "tsdown src/**/*.ts --format esm,cjs --dts --watch --clean",
    "build": "tsdown src/**/*.ts --format esm,cjs --dts --clean",
    "clean": "rm -rf node_modules/ .turbo/ dist/"
  },
  "dependencies": {
    "@temporalio/activity": "catalog:"
  },
  "devDependencies": {
    "@boilerplate/common": "workspace:*",
    "@boilerplate/typescript-config": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}